POSTGRES_USER=bcb
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=bcb
DATABASE_URL=postgres://bcb:change-me-db-password@db:5432/bcb

JWT_SECRET=change-me-long-random-jwt-secret
JWT_EXPIRES_IN=1d
BCB_ADMIN_PASSWORD=change-me-admin-password
INTERNAL_API_TOKEN=change-me-internal-worker-token

CORS_ORIGIN=https://bcb.yanlucas.com
BCB_API_BASE_URL=https://bcb.yanlucas.com/api
BCB_REALTIME_BASE_URL=https://bcb.yanlucas.com

API_PUBLISHED_PORT=3020
WEB_PUBLISHED_PORT=4220

QUEUE_POLL_INTERVAL_MS=250
QUEUE_SENT_DELAY_MS=500
QUEUE_DELIVERED_DELAY_MS=1000
RECIPIENT_SIMULATOR_ENABLED=true
RECIPIENT_SIMULATOR_READ_DELAY_MS=1500
RECIPIENT_SIMULATOR_TYPING_MS=2000
